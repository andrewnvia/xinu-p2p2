#include <xinu.h>
#include <stdio.h>

void timed_execution(uint32 runtime){
	    while(proctab[currpid].runtime<runtime);
}

int main() {
	pid32 prA, prB;
    int i, j;
    i = 10;
    j = 10;
    while (TRUE) {
        kprintf("\n");
        
        kprintf("=== RUNTIME %d ===================================================\n", i);
        sleepms(50); // wait for print

        prA = create_user_process(timed_execution, 1024, "timed_execution", 1, i);
        prB = create_user_process(timed_execution, 1024, "timed_execution", 1, i);

        set_tickets(prA, 50);
        set_tickets(prB, 50);

        resume(prA);
        resume(prB);

        sleepms(i * 2 + 500); // wait for user processes to terminate	

        kprintf("process %d:: runtime=%d, turnaround time=%d\n",prA, proctab[prA].runtime, proctab[prA].turnaroundtime);
        kprintf("process %d:: runtime=%d, turnaround time=%d\n",prB, proctab[prB].runtime, proctab[prB].turnaroundtime);
        kprintf("%d, %.7f\n", i, (proctab[prA].turnaroundtime < proctab[prB].turnaroundtime) ? 
                                    ((double)proctab[prA].turnaroundtime)/((double)proctab[prB].turnaroundtime) 
                                :   ((double)proctab[prB].turnaroundtime)/((double)proctab[prA].turnaroundtime));
        kprintf("==================================================================\n\n");

        sleepms(50); // wait for print
        if (i == j * 10) {
            j *= 10;
        }
        i += j;
        if (i > 100000) {
            kprintf("Done!\n\n");
            break;
        }
    }
    return OK;
}
